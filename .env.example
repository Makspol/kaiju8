# Backend
KAIJU8_DB_PATH=kaiju8.db
KAIJU8_AUTH_SECRET=change-this-secret-for-local-dev
KAIJU8_SCHEDULER_ENABLED=false
KAIJU8_SCHEDULER_INTERVAL_SECONDS=30
KAIJU8_SCHEDULER_BATCH_SIZE=20

# Optional fallback keys. Prefer adding API keys through the Credentials screen.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional fallback tool keys. Prefer adding API keys through the Credentials screen.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
